{
  "name": "herdr-lcars",
  "version": "0.1.0",
  "description": "Command up to 2,000 Herdr AI agents from one LCARS bridge, track Claude/Codex quota per account, and hand off verified context without losing work.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlcases/herdr-lcars.git"
  },
  "homepage": "https://github.com/jlcases/herdr-lcars#readme",
  "bugs": {
    "url": "https://github.com/jlcases/herdr-lcars/issues"
  },
  "keywords": ["herdr", "herdr-plugin", "lcars", "agent", "multi-agent", "observability", "context-memory", "handoff", "claude-code", "codex"],
  "type": "module",
  "private": true,
  "bin": {
    "herdr-lcars": "bin/lcars-bridge.mjs",
    "lcars-bridge": "bin/lcars-bridge.mjs"
  },
  "files": [
    "bin/",
    "public/",
    "server/",
    "tools/fuel.mjs",
    "herdr-plugin.toml",
    "README.es.md",
    "docs/",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/lcars-bridge.mjs",
    "check": "node tools/check-source.mjs",
    "check:shell": "shellcheck -S warning bin/plugin bin/lcars-statusline",
    "test": "node --test tests/*.test.mjs tests/*/*.test.mjs",
    "release:check": "npm run check && npm run check:shell && npm test && npm pack --dry-run"
  },
  "os": ["darwin", "linux"],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
